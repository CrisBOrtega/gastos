type Usuario {
    id: ID!
    username: String!
    email: String!
    password: String!
}

input UsuarioInput {
    username: String!
    email: String!
    password: String!
}

type Query {
    usuarios: [Usuario!]!
    usuario(id: ID!): Usuario
}

type Mutation {
    createUsuario(input: UsuarioInput!): Usuario!
    updateUsuario(id: ID!, input: UsuarioInput!): Usuario
    deleteUsuario(id: ID!): Boolean!
}
